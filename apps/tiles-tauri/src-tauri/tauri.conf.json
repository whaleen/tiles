{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "tiles",
  "version": "0.1.0",
  "identifier": "com.whaleen.tiles",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "vite",
    "beforeBuildCommand": "vite build"
  },
  "app": {
    "windows": [
      {
        "title": "tiles",
        "width": 1440,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2QUYyQUYyOTA0Q0NGNTIKUldSU3oweVE4aXF2SmlkU3VSOSt1RU9qNkYxb3dEdWZYZlJ1dnNOMjQyMW9weERaWklJZUx0cVoK",
      "endpoints": [
        "https://raw.githubusercontent.com/whaleen/homebrew-tap/main/tiles-latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
